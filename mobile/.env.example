# HousePlan mobile: copy to .env (gitignored). Metro INLINES these at build
# time: restart with `npx expo start -c` (or export with --clear) after any
# change. Everything here ships inside the app bundle: ids and labels only,
# never a secret. The phone holds no Xenition package and no key; it only
# talks to the worker.

# The worker: production by default (the app adds /api/v1). Leave empty to
# use a local worker on the dev machine's LAN address and EXPO_PUBLIC_API_PORT.
EXPO_PUBLIC_API_URL=https://houseplan.xenition.com
EXPO_PUBLIC_API_PORT=8797

# Must match backend PRODUCT_* exactly, and exist in both stores (BRD §2.2).
EXPO_PUBLIC_IAP_MONTHLY=houseplan.pro.monthly
EXPO_PUBLIC_IAP_YEARLY=houseplan.pro.annual
# Shown only when the store has not returned its own price, labelled "list price",
# with Subscribe disabled. Never charged: the store's price always wins.
EXPO_PUBLIC_YEARLY_PRICE_LABEL=$99.99
EXPO_PUBLIC_MONTHLY_PRICE_LABEL=$14.99

EXPO_PUBLIC_SUPPORT_EMAIL=support@houseplan.xenition.com
EXPO_PUBLIC_WEBSITE_URL=https://houseplan.xenition.com
EXPO_PUBLIC_APPLE_APP_ID=
EXPO_PUBLIC_ANDROID_PACKAGE=com.xenition.houseplan
# EAS project id: required for push tokens in a dev/store build (`eas init`).
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_TERMS_VERSION=2026-10-07

# Meta ads measurement (react-native-fbsdk-next). Both empty = off: no SDK
# config in the build, no tracking prompt. Even when set, nothing is sent
# until the person grants advertising consent in the app.
EXPO_PUBLIC_META_APP_ID=
EXPO_PUBLIC_META_CLIENT_TOKEN=
